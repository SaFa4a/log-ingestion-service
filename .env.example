# Copy to .env for local (non-Docker) development.
# docker-compose.yml sets these directly for the containerized run —
# you do not need this file for `docker compose up`.

PORT=8080
DATABASE_URL=postgres://loguser:logpass@localhost:5432/logs
PG_POOL_MAX=8
PG_STATEMENT_TIMEOUT_MS=10000

# Retention: how many days of logs to keep, and how often the
# partition-maintenance job runs.
RETENTION_DAYS=30
RETENTION_INTERVAL_MS=3600000

# Optional auth feature. Both default to disabled/unset, which yields
# the plain, unauthenticated core service required by the load-generator
# contract. Set AUTH_ENABLED=true and provide AUTH_MASTER_KEY to turn it on.
AUTH_ENABLED=false
AUTH_MASTER_KEY=

LOG_LEVEL=info
